datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Job {
  id              String    @id @default(uuid())
  jobNumber       String    @unique // HBL NO.
  status          String    @default("NEW")
  agentEmail      String
  
  // -- Parties --
  shipperName     String?
  consigneeName   String?
  
  // -- Routing & Dates --
  pol             String?   // Port of Loading
  pod             String?   // Port of Discharge
  readyTime       String?
  cutOff          String?
  etd             String?
  eta             String?
  
  // -- Cargo Details --
  commodity       String?
  carrier         String?   // LCL, FCL
  volumeRaw       String?   // 2PLTS/680KGS/2.577CBM
  weightKgs       Float?
  volumeCbm       Float?
  
  // -- Charges --
  podCharge       String?
  ofps            String?   // Ocean Freight & Profit Share
  
  attachmentUrl   String?
  emailThreadId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
